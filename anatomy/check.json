[
  ["click", "[data-seal='0'][data-half='0']"],
  ["eval", "if(document.querySelector('.iso-stage').dataset.phase!=='open') throw Error('seal selection failed')"],
  ["click", "[data-kind-choice='glass']"],
  ["click", "[data-action='insert']"],
  ["eval", "if(document.querySelector('.iso-stage').dataset.phase!=='rejected'||!document.querySelector('[data-readout]').textContent.includes('addresses held 0')) throw Error('transparent refusal failed')"],
  ["click", "[data-kind-choice='opaque']"],
  ["click", "[data-action='insert']"],
  ["until", "document.querySelector('.iso-stage').dataset.phase==='delivered'", 8000],
  ["eval", "if(!document.querySelector('[data-readout]').textContent.includes('1 delivered · addresses held 0')||!document.querySelector('[data-seal='+'\"0\"'+'][data-state=split]')) throw Error('mined delivery failed')"],
  ["click", "[data-action='expire']"],
  ["eval", "if(!document.querySelector('[data-readout]').textContent.includes('1 expired')||!document.querySelector('[data-seal='+'\"1\"'+'][data-state=expired]')) throw Error('unopened expiry failed')"]
]
